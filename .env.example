# Copie os valores para Environment no Render. Nunca publique credenciais reais.
DATABASE_URL=postgresql://usuario:senha@servidor/banco
SECRET_KEY=substitua_por_uma_chave_aleatoria_de_pelo_menos_32_caracteres
PUBLIC_BASE_URL=https://controle-validade-veneza-1.onrender.com
COOKIE_SECURE=true

# Somente UM processo sempre ativo deve executar os agendamentos.
# Para testar no Render Free sem e-mails, mantenha false.
SCHEDULER_ENABLED=false

# Identificação exigida pela Open Food Facts (não é uma senha).
PRODUCT_API_USER_AGENT=VenezaValidade/2.0 (seu-email-de-contato@exemplo.com)

# Gmail SMTP: requer hospedagem com saída SMTP permitida (Render Free bloqueia).
# Habilite verificação em duas etapas e gere uma senha de app no Google.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=seu-remetente@gmail.com
MAIL_PASSWORD=senha_de_app_do_google
MAIL_DEFAULT_SENDER=seu-remetente@gmail.com
